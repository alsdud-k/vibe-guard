{
  "Comment": "VibeGuard Phase 4 — Complete Pipeline with Parallel Analysis",
  "StartAt": "CollectPR",
  "States": {
    "CollectPR": {
      "Type": "Task",
      "Resource": "${PrCollectorArn}",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "MaxAttempts": 2,
          "IntervalSeconds": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "HandleError"
        }
      ],
      "Next": "FilterRelevance"
    },

    "FilterRelevance": {
      "Type": "Task",
      "Resource": "${RelevanceFilterArn}",
      "TimeoutSeconds": 15,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "HandleError"
        }
      ],
      "Next": "CheckRelevance"
    },

    "CheckRelevance": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.relevance.level",
          "StringEquals": "SKIP",
          "Next": "SkipAnalysis"
        },
        {
          "Variable": "$.relevance.level",
          "StringEquals": "LOW",
          "Next": "PostLowRiskComment"
        }
      ],
      "Default": "ParallelAnalysis"
    },

    "ParallelAnalysis": {
      "Type": "Parallel",
      "ResultPath": "$.parallel_results",
      "Branches": [
        {
          "StartAt": "CollectContext",
          "States": {
            "CollectContext": {
              "Type": "Task",
              "Resource": "${ContextCollectorArn}",
              "TimeoutSeconds": 30,
              "Retry": [
                {
                  "ErrorEquals": ["States.TaskFailed"],
                  "MaxAttempts": 1,
                  "IntervalSeconds": 2,
                  "BackoffRate": 1.5
                }
              ],
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "ResultPath": "$.error",
                  "Next": "ContextFallback"
                }
              ],
              "End": true
            },
            "ContextFallback": {
              "Type": "Pass",
              "Result": {
                "repository_context": {
                  "evidence_files": [],
                  "pattern_statistics": {},
                  "error": "collection_failed"
                }
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "SemgrepScan",
          "States": {
            "SemgrepScan": {
              "Type": "Task",
              "Resource": "${SemgrepScannerArn}",
              "TimeoutSeconds": 60,
              "Catch": [
                {
                  "ErrorEquals": ["States.ALL"],
                  "ResultPath": "$.error",
                  "Next": "SemgrepFallback"
                }
              ],
              "End": true
            },
            "SemgrepFallback": {
              "Type": "Pass",
              "Result": {
                "semgrep_results": {
                  "findings": [],
                  "scan_status": "skipped",
                  "error": "scan_failed"
                }
              },
              "End": true
            }
          }
        }
      ],
      "Next": "MergeParallelResults"
    },

    "MergeParallelResults": {
      "Type": "Pass",
      "Parameters": {
        "repository.$": "$.repository",
        "pull_request.$": "$.pull_request",
        "installation_id.$": "$.installation_id",
        "diff.$": "$.diff",
        "vibeguard_config.$": "$.vibeguard_config",
        "relevance.$": "$.relevance",
        "repository_context.$": "$.parallel_results[0].repository_context",
        "semgrep_results.$": "$.parallel_results[1].semgrep_results"
      },
      "Next": "DetectRegression"
    },

    "DetectRegression": {
      "Type": "Task",
      "Resource": "${RegressionDetectorArn}",
      "TimeoutSeconds": 30,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.regression_error",
          "Next": "BedrockReview"
        }
      ],
      "Next": "BedrockReview"
    },

    "BedrockReview": {
      "Type": "Task",
      "Resource": "${BedrockReviewerArn}",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": ["ThrottlingException", "BedrockThrottling", "ServiceUnavailableException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.bedrock_error",
          "Next": "BuildResult"
        }
      ],
      "Next": "BuildResult"
    },

    "BuildResult": {
      "Type": "Task",
      "Resource": "${ResultBuilderArn}",
      "TimeoutSeconds": 15,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.build_error",
          "Next": "PostComment"
        }
      ],
      "Next": "PostComment"
    },

    "PostComment": {
      "Type": "Task",
      "Resource": "${GithubCommenterArn}",
      "TimeoutSeconds": 15,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "MaxAttempts": 2,
          "IntervalSeconds": 1,
          "BackoffRate": 1.5
        }
      ],
      "End": true
    },

    "PostLowRiskComment": {
      "Type": "Task",
      "Resource": "${GithubCommenterArn}",
      "Parameters": {
        "mode": "low_risk",
        "input.$": "$"
      },
      "TimeoutSeconds": 15,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "MaxAttempts": 2,
          "IntervalSeconds": 1,
          "BackoffRate": 1.5
        }
      ],
      "End": true
    },

    "SkipAnalysis": {
      "Type": "Succeed"
    },

    "HandleError": {
      "Type": "Task",
      "Resource": "${GithubCommenterArn}",
      "Parameters": {
        "mode": "error",
        "input.$": "$"
      },
      "TimeoutSeconds": 15,
      "End": true
    }
  }
}
