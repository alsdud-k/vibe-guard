{
  "Comment": "VibeGuard Phase 3 — Regression Detection + Bedrock Review",
  "StartAt": "CollectPR",
  "States": {
    "CollectPR": {
      "Type": "Task",
      "Resource": "${PrCollectorArn}",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "MaxAttempts": 2,
          "IntervalSeconds": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "HandleError"
        }
      ],
      "Next": "FilterRelevance"
    },

    "FilterRelevance": {
      "Type": "Task",
      "Resource": "${RelevanceFilterArn}",
      "TimeoutSeconds": 15,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "HandleError"
        }
      ],
      "Next": "CheckRelevance"
    },

    "CheckRelevance": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.relevance.level",
          "StringEquals": "SKIP",
          "Next": "PostSkipComment"
        },
        {
          "Variable": "$.relevance.level",
          "StringEquals": "LOW",
          "Next": "PostLowRiskComment"
        }
      ],
      "Default": "CollectContext"
    },

    "CollectContext": {
      "Type": "Task",
      "Resource": "${ContextCollectorArn}",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "MaxAttempts": 1,
          "IntervalSeconds": 2,
          "BackoffRate": 1.5
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.context_error",
          "Next": "DetectRegression"
        }
      ],
      "Next": "DetectRegression"
    },

    "DetectRegression": {
      "Type": "Task",
      "Resource": "${RegressionDetectorArn}",
      "TimeoutSeconds": 30,
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.regression_error",
          "Next": "BedrockReview"
        }
      ],
      "Next": "BedrockReview"
    },

    "BedrockReview": {
      "Type": "Task",
      "Resource": "${BedrockReviewerArn}",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": ["ThrottlingException", "BedrockThrottling", "ServiceUnavailableException"],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.bedrock_error",
          "Next": "PostComment"
        }
      ],
      "Next": "PostComment"
    },

    "PostComment": {
      "Type": "Task",
      "Resource": "${GithubCommenterArn}",
      "TimeoutSeconds": 15,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "MaxAttempts": 2,
          "IntervalSeconds": 1,
          "BackoffRate": 1.5
        }
      ],
      "End": true
    },

    "PostLowRiskComment": {
      "Type": "Task",
      "Resource": "${GithubCommenterArn}",
      "Parameters": {
        "mode": "low_risk",
        "input.$": "$"
      },
      "TimeoutSeconds": 15,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "MaxAttempts": 2,
          "IntervalSeconds": 1,
          "BackoffRate": 1.5
        }
      ],
      "End": true
    },

    "PostSkipComment": {
      "Type": "Task",
      "Resource": "${GithubCommenterArn}",
      "Parameters": {
        "mode": "skip",
        "input.$": "$"
      },
      "TimeoutSeconds": 15,
      "End": true
    },

    "HandleError": {
      "Type": "Task",
      "Resource": "${GithubCommenterArn}",
      "Parameters": {
        "mode": "error",
        "input.$": "$"
      },
      "TimeoutSeconds": 15,
      "End": true
    }
  }
}
